# Gradle
.gradle/
build/
!gradle-wrapper.jar
local.properties

# IDE
.idea/
*.iml
.fleet/
.vscode/

# Android
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# Signed release output. Not covered by `build/`: Android Studio's "Generate Signed Bundle / APK" wizard writes
# beside the module rather than under it, so the profiles and metadata it drops here are untracked by default and
# get swept up by the next `git add -A`. The APK itself is already caught by `*.apk` above; this is the rest.
app/release/

# Kotlin
.kotlin/

# Crash logs
hs_err_pid*

# OS
.DS_Store
Thumbs.db

# Local MCP config (machine-specific paths)
.mcp.json
.serena/

# Keystore — never commit signing keys
*.jks
*.keystore
keystore.properties

# Play Console package-name ownership token (Android developer verification). Kept on disk so re-verifying does not
# mean another trip through the console, but it identifies the developer account rather than the app, so it is not
# the repo's to carry.
app/src/main/assets/adi-registration.properties

# Captured logcat — the icon-measurement diagnostics are dumped here while chasing a sizing bug
# (see docs/ICON_SIZE_PLAN.md). One device's output, never a shared artifact.
icon-measure.txt
*.logcat
