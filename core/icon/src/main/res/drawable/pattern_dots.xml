<!--
  One dot in the middle and a quarter of one at each corner.

  The corner circles are authored whole and centred *on* the tile's corners, so the drawable clips three quarters of
  each away and the neighbouring tiles bring them back. That is what makes the pattern seamless without the four
  edges having to be drawn to match by hand.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,50 A18,18 0 1 0 68,50 A18,18 0 1 0 32,50 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M-18,0 A18,18 0 1 0 18,0 A18,18 0 1 0 -18,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M82,0 A18,18 0 1 0 118,0 A18,18 0 1 0 82,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M-18,100 A18,18 0 1 0 18,100 A18,18 0 1 0 -18,100 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M82,100 A18,18 0 1 0 118,100 A18,18 0 1 0 82,100 Z" />
</vector>
