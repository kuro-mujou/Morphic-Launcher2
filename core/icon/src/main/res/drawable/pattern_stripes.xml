<!--
  Half the tile filled, which tiles into equal bars of mark and ground.

  Authored horizontal rather than diagonal on purpose: the effect carries an angle of its own, so a slanted tile
  would be a second way to say the same thing — and one that could only reach the angles it was drawn at.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M0,0 H100 V50 H0 Z" />
</vector>
