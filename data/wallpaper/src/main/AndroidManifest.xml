<?xml version="1.0" encoding="utf-8"?>
<!--
  The permission lives with the code that needs it rather than in `app`'s manifest: this module is the only thing that
  calls `WallpaperManager.setBitmap`, so the capability travels with it and the manifest merger hands it to whichever
  application includes the module. `app` gains nothing by restating it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
      Declared here for the same reason, and it matters more: a `WallpaperService` is instantiated by the *system*, so
      the class, its intent filter and its metadata have to be visible in the merged manifest. Keeping the declaration
      beside the service means a module that includes `data:wallpaper` gets a working live wallpaper, and one that does
      not cannot end up with a dangling entry naming a class it lacks.

      `BIND_WALLPAPER` is what stops any app but the system binding to it — the platform requires it of every wallpaper
      service, and without it the chooser refuses to list this one.
    -->
    <application>
        <service
            android:name="inkspire.morphic.data.wallpaper.RotatingWallpaperService"
            android:exported="true"
            android:label="@string/rotating_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/rotating_wallpaper" />
        </service>
    </application>

</manifest>
