<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      What `PlatformSystemShade` needs to pull down the notification shade or quick settings, and all it needs. Normal
      protection level: the system grants it at install, so no prompt ever appears for it.
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />


    <!--
      **What makes Uninstall work at all.** An app targeting API 29 or later must hold this to ask the system to
      remove a package; without it the platform's uninstaller activity finishes the moment it opens, so the user
      taps Uninstall and simply nothing happens — no dialog, no error, and no exception for `AppUninstaller` to
      catch and log. AOSP's own Launcher3 requests it for the same one action.

      It is a *normal* permission: granted at install, never prompted, and it only lets us **ask** — the system
      still shows its own confirmation and does the removal, which is the whole contract `AppUninstaller` documents.

      Declared here rather than in `app` because this module is the only thing that starts that intent, the same
      rule `data:wallpaper` follows for `SET_WALLPAPER`. L1 asked for `QUERY_ALL_PACKAGES` instead, which happened
      to cover this and a great deal more besides.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Package visibility (Android 11+): to enumerate every launchable app and read its icon through
      LauncherApps we must declare the launcher intent here. This is deliberately narrower than
      QUERY_ALL_PACKAGES — it exposes only activities that answer MAIN/LAUNCHER, which is exactly the set we
      list. Once L2 is the default home app (P9) LauncherApps is exempt from visibility filtering anyway;
      this keeps it working while L2 is still an ordinary app. Merges into the app manifest.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!--
          `ShadeSwipeService`, the optional way to reach the notification side of a separate shade. Only the system can
          bind it (`BIND_ACCESSIBILITY_SERVICE`), and it does nothing until the user switches it on in accessibility
          settings.
        -->
        <service
            android:name="inkspire.morphic.data.apps.ShadeSwipeService"
            android:exported="true"
            android:label="@string/shade_swipe_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/shade_swipe_service" />
        </service>
    </application>

</manifest>
